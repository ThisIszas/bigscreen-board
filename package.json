{
  "name": "@thisiszas/bigscreen-board",
  "version": "2.0.1",
  "description": "数据大屏屏幕适配库: 1920x1080 设计稿 + 等比 scale 自适应(ScaleScreen/useScreenScale), 零 echarts/字体依赖",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src",
    "declarations",
    "example",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "big-screen",
    "dashboard",
    "data-visualization",
    "scale-screen",
    "data-v"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThisIszas/bigscreen-board.git"
  },
  "homepage": "https://github.com/ThisIszas/bigscreen-board",
  "bugs": {
    "url": "https://github.com/ThisIszas/bigscreen-board/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.6.2",
    "sass": "^1.102.0",
    "vite": "^4.5.14",
    "vue": "^3.3.1"
  },
  "scripts": {
    "build": "vite build && node scripts/copy-types.mjs",
    "prepublishOnly": "npm run build"
  }
}
